# --- Supabase (local dev stack from `npx supabase start`; these are the CLI's standard local demo keys) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# --- AI assistant: Google Gemini via its OpenAI-compatible endpoint. Server-only; never exposed to the browser.
# Get a key at https://aistudio.google.com/apikey and paste it below (GEMINI_API_KEY also works).
AI_API_KEY=your-gemini-key
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-3.8-flash
